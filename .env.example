# Backend Configuration
# Comma-separated list of allowed origins for CORS. Defaults to http://localhost:3000 if not set.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional API key for protecting POST endpoints. If unset, endpoints remain fully open (useful for local dev).
VPP_API_KEY=your_super_secret_api_key_here

# Frontend Configuration
# URL of the backend API for HTTP requests.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL of the backend WebSocket for real-time telemetry.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
